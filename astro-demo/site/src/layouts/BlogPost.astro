---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import SiteLayout from './SiteLayout.astro';
import { taxonomySlug } from '../lib/taxonomy';

type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, heroImage, category, tags } = Astro.props;
---

<SiteLayout title={title} description={description}>
	<article class="article">
		{heroImage && <div class="hero-image"><Image width={1200} height={600} src={heroImage} alt="" /></div>}
		<div class="article-header">
			<p class="meta"><a href={`/category/${taxonomySlug(category)}/`}>{category}</a><span>·</span><FormattedDate date={pubDate} /></p>
			<h1>{title}</h1>
			<p class="description">{description}</p>
			{updatedDate && <p class="updated">마지막 수정: <FormattedDate date={updatedDate} /></p>}
			<div class="tags" aria-label="태그">
				{tags.map((tag) => <a href={`/tag/${taxonomySlug(tag)}/`}>#{tag}</a>)}
			</div>
		</div>
		<div class="prose"><slot /></div>
	</article>
</SiteLayout>

<style>
	.article { max-width: 820px; margin: 0 auto; }
	.hero-image { margin-bottom: 1.5rem; }
	.hero-image img { display: block; width: 100%; height: auto; border-radius: 16px; }
	.article-header { padding: 0.5rem 0 1.5rem; border-bottom: 1px solid rgb(var(--gray-light)); }
	.meta { display: flex; align-items: center; gap: 0.6rem; margin: 0 0 0.75rem; color: rgb(var(--gray)); font-size: 0.85rem; }
	.meta a { color: var(--accent); font-weight: 700; text-decoration: none; }
	h1 { margin: 0; font-size: clamp(2rem, 5vw, 3rem); letter-spacing: -0.04em; }
	.description { margin: 0.6rem 0 0; color: rgb(var(--gray)); font-size: 1rem; }
	.updated { color: rgb(var(--gray)); font-size: 0.75rem; }
	.tags { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 1rem; }
	.tags a { padding: 0.2rem 0.65rem; border: 1px solid rgb(var(--gray-light)); border-radius: 999px; color: rgb(var(--gray)); font-size: 0.75rem; text-decoration: none; }
	.tags a:hover { border-color: var(--accent); color: var(--accent); }
	.prose { max-width: 720px; margin: 0 auto; padding-top: 1.5rem; color: rgb(var(--gray-dark)); }
	.prose :global(h2) { margin-top: 2rem; font-size: 1.65rem; }
	.prose :global(p), .prose :global(li) { font-size: 1rem; line-height: 1.85; }
</style>

