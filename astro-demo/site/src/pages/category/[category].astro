---
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { CATEGORIES } from '../../lib/taxonomy';

export async function getStaticPaths() {
	return CATEGORIES.map((category) => ({ params: { category: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const posts = (await getCollection('blog'))
	.filter((post) => post.data.category.toLowerCase() === category.name.toLowerCase())
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<SiteLayout title={`${category.name} 카테고리`}>
	<p class="eyebrow">CATEGORY</p>
	<h1>{category.name}</h1>
	<p class="description">{category.name} 카테고리의 글을 모았습니다.</p>
	{posts.length ? <div class="post-list">{posts.map((post) => <PostCard post={post} />)}</div> : <p class="empty">아직 이 카테고리에 등록된 글이 없습니다.</p>}
</SiteLayout>

<style>
	.eyebrow { margin: 0 0 0.4rem; color: var(--accent); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; }
	h1 { margin: 0; }
	.description { margin: 0.5rem 0 1.6rem; color: rgb(var(--gray)); }
	.post-list { display: grid; gap: 0.85rem; }
	.empty { padding: 2rem; border: 1px dashed rgb(var(--gray-light)); border-radius: 14px; color: rgb(var(--gray)); text-align: center; }
</style>

