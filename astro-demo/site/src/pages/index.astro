---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<SiteLayout>
	<section class="intro">
		<p class="eyebrow">IDEAS, NOTES &amp; DISCOVERIES</p>
		<h1>관심 있는 주제를<br /><span>차곡차곡 기록합니다.</span></h1>
		<p class="intro-copy">IT와 AI, 주식에 관한 글을 모아 소개하는 블로그입니다.</p>
	</section>
	<section aria-labelledby="latest-heading">
		<div class="section-heading">
			<div><p class="eyebrow">LATEST ARTICLES</p><h2 id="latest-heading">최근 글</h2></div>
			<a href="/blog/">모든 글 보기 →</a>
		</div>
		<div class="post-list">{posts.map((post) => <PostCard post={post} />)}</div>
	</section>
</SiteLayout>

<style>
	.intro { margin: 0 0 3rem; padding: clamp(1.6rem, 5vw, 3.4rem); border: 1px solid rgb(var(--gray-light)); border-radius: 22px; background: radial-gradient(ellipse at 85% 5%, rgba(111, 132, 255, 0.18), transparent 48%), linear-gradient(135deg, #1b2230, #151922); }
	.eyebrow { margin: 0 0 0.6rem; color: var(--accent); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.13em; }
	h1 { margin: 0; font-size: clamp(2rem, 5vw, 3.4rem); letter-spacing: -0.045em; }
	h1 span { color: #aab8ff; }
	.intro-copy { max-width: 38rem; margin: 1rem 0 0; color: rgb(var(--gray)); font-size: 1rem; }
	.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
	.section-heading h2 { margin: 0; font-size: 1.55rem; }
	.section-heading a { font-size: 0.85rem; text-decoration: none; }
	.post-list { display: grid; gap: 0.85rem; }
	@media (max-width: 550px) { .section-heading { align-items: start; } .section-heading a { margin-top: 1rem; white-space: nowrap; } }
</style>

