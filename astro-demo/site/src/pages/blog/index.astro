---
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<SiteLayout title="전체 글">
	<p class="eyebrow">THE JOURNAL</p>
	<h1>전체 글</h1>
	<p class="description">카테고리와 태그로 관심 있는 주제를 찾아보세요.</p>
	<div class="post-list">{posts.map((post) => <PostCard post={post} />)}</div>
</SiteLayout>

<style>
	.eyebrow { margin: 0 0 0.4rem; color: var(--accent); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; }
	h1 { margin: 0; }
	.description { margin: 0.5rem 0 1.6rem; color: rgb(var(--gray)); }
	.post-list { display: grid; gap: 0.85rem; }
</style>

