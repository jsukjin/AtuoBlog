---
import BaseHead from '../../../../components/BaseHead.astro';
import AsFolioCustomPreview from '../../../../components/AsFolioCustomPreview.astro';
---

<html lang="ko">
	<head><BaseHead title="As-folio 블로그 미리보기" description="상단 메뉴, 초록 강조색, 큰 썸네일을 적용한 As-folio 스타일 블로그 전체 화면 미리보기" /></head>
	<body class="fullscreen-body">
		<AsFolioCustomPreview />
		<a class="exit-preview" href="/">블로그 홈으로 돌아가기 ↗</a>
	</body>
</html>

<style>
	:global(html), :global(body.fullscreen-body) { width: 100%; min-height: 100%; margin: 0; background: #101511; }
	.exit-preview { position: fixed; right: 1rem; bottom: 1rem; z-index: 5; padding: .55rem .8rem; border: 1px solid #32c77d; border-radius: 999px; background: rgba(16,21,17,.93); color: #9de8bf; font-size: .72rem; text-decoration: none; box-shadow: 0 5px 24px rgba(0,0,0,.35); }
	.exit-preview:hover { background: #183322; }
</style>
