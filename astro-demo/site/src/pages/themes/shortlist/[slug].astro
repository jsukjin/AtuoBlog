---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { themeShortlist } from '../../../data/theme-shortlist';
import AsFolioCustomPreview from '../../../components/AsFolioCustomPreview.astro';

export function getStaticPaths() {
	return themeShortlist.map((theme, index) => ({
		params: { slug: theme.slug },
		props: {
			theme,
			index,
			previous: themeShortlist[(index + themeShortlist.length - 1) % themeShortlist.length],
			next: themeShortlist[(index + 1) % themeShortlist.length],
		},
	}));
}

const { theme, index, previous, next } = Astro.props;
---

<SiteLayout title={`${theme.name} 테마 미리보기`} description={`${theme.name} Astro 블로그 테마의 실제 데모와 블로그 기능을 확인합니다.`}>
	<div class="page-top">
		<a class="back" href="/themes/shortlist/">← 후보 6개 목록</a>
		<div class="counter">{String(index + 1).padStart(2, '0')} / 06</div>
	</div>
	<header class="theme-head" style={`--tone:${theme.accent}`}>
		<div>
			<p class="eyebrow">{theme.style}</p>
			<h1>{theme.name}</h1>
			<p class="description">{theme.description}</p>
		</div>
		<div class="head-actions">
			<a class="primary" href={theme.demo} target="_blank" rel="noreferrer">{theme.demoNote ? '작성자의 실제 사이트 열기 ↗' : '원본 데모를 새 탭으로 크게 열기 ↗'}</a>
			{theme.officialDemo && <a class="source" href={theme.officialDemo} target="_blank" rel="noreferrer">공식 데모 주소 (현재 중지) ↗</a>}
			<a class="source" href={theme.source} target="_blank" rel="noreferrer">테마 상세 정보 ↗</a>
		</div>
	</header>

	{theme.slug === 'as-folio' ? (
		<div class="preview-instructions"><strong>요청 반영 미리보기</strong><span>상단 가로 메뉴, 초록색 강조, 크게 보이는 썸네일을 적용한 As-folio 스타일 블로그 샘플입니다. 메뉴와 태그 검색도 직접 눌러볼 수 있습니다.</span></div>
	) : <div class="preview-instructions">
		<strong>실제 데모 조작하기</strong>
		<span>{theme.demoNote || '미리보기 화면 안에서 테마의 메뉴를 눌러 글 목록 → 글 상세 → 태그/카테고리 → 검색을 확인해보세요.'} 미리보기가 비어 있거나 잘리지 않으면 위의 새 탭 링크를 이용하세요.</span>
	</div>}
	<div class="demo-frame" style={`--tone:${theme.accent}`}>
		<div class="frame-bar"><span><i></i><i></i><i></i></span><span>{theme.name} · {theme.demoNote ? '작성자 사이트 대체 미리보기' : '실제 공개 데모'}</span><a href={theme.demo} target="_blank" rel="noreferrer">새 탭 ↗</a></div>
		{theme.slug === 'as-folio' ? <AsFolioCustomPreview /> : <iframe src={theme.demo} title={`${theme.name} 실제 테마 데모`} loading="eager" referrerpolicy="strict-origin-when-cross-origin"></iframe>}
	</div>

	<section class="review" aria-labelledby="review-title">
		<div class="review-heading"><div><p class="eyebrow">BLOG CHECKLIST</p><h2 id="review-title">블로그 운영에 필요한 기능</h2></div><p>표시는 테마 설명 문서 기준입니다. 실제 데모에서 메뉴와 각 화면도 확인해보세요.</p></div>
		<div class="feature-grid">
			{theme.features.map((feature) => (
				<div class="feature">
					<div><h3>{feature.label}</h3><span class:list={['status', { confirmed: feature.status === '지원' || feature.status === '파일 기반', check: feature.status === '데모에서 확인' }]}>{feature.status}</span></div>
					<p>{feature.note}</p>
				</div>
			))}
		</div>
		<p class="fit"><strong>잘 맞는 경우</strong> · {theme.fit}</p>
	</section>

	<nav class="page-switch" aria-label="테마 미리보기 이동">
		<a href={`/themes/shortlist/${previous.slug}/`}>← {previous.name}</a>
		<a href="/themes/shortlist/">6개 목록</a>
		<a href={`/themes/shortlist/${next.slug}/`}>{next.name} →</a>
	</nav>
</SiteLayout>

<style>
	.page-top { display: flex; align-items: center; justify-content: space-between; margin: 0 0 .7rem; }
	.back { color: rgb(var(--gray)); font-size: .76rem; text-decoration: none; }
	.back:hover { color: var(--accent); }
	.counter { color: rgb(var(--gray)); font-size: .7rem; font-weight: 800; letter-spacing: .12em; }
	.theme-head { --tone: #20c879; display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: .85rem; }
	.eyebrow { margin: 0 0 .2rem; color: var(--tone, var(--accent)); font-size: .66rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
	h1 { margin: 0; font-size: clamp(1.65rem, 3vw, 2.35rem); line-height: 1.15; }
	.description { max-width: 46rem; margin: .4rem 0 0; color: rgb(var(--gray)); font-size: .78rem; }
	.head-actions { display: flex; flex-direction: column; align-items: flex-end; gap: .45rem; flex: 0 0 auto; }
	.head-actions a { text-decoration: none; }
	.primary { padding: .55rem .8rem; border: 1px solid var(--tone); border-radius: .6rem; color: var(--tone); font-size: .74rem; font-weight: 800; }
	.primary:hover { background: color-mix(in srgb, var(--tone) 12%, transparent); }
	.source { color: rgb(var(--gray)); font-size: .67rem; }
	.preview-instructions { display: flex; align-items: flex-start; gap: .65rem; margin-bottom: .45rem; color: rgb(var(--gray)); font-size: .71rem; }
	.preview-instructions strong { flex: 0 0 auto; color: rgb(var(--gray-dark)); }
	.preview-instructions b { color: rgb(var(--gray-dark)); }
	.demo-frame { --tone: #20c879; overflow: hidden; border: 1px solid color-mix(in srgb, var(--tone) 44%, rgb(var(--gray-light))); border-radius: .85rem; background: white; }
	.frame-bar { display: flex; align-items: center; gap: .7rem; height: 2rem; padding: 0 .75rem; border-bottom: 1px solid #d8d8d8; background: #f3f4f6; color: #464b56; font: 600 .65rem/1 sans-serif; }
	.frame-bar > span:first-child { display: flex; gap: .24rem; }
	.frame-bar i { width: .48rem; height: .48rem; border-radius: 50%; background: #ee6a5e; }
	.frame-bar i:nth-child(2) { background: #f5bd4f; }
	.frame-bar i:nth-child(3) { background: #61c454; }
	.frame-bar > span:nth-child(2) { flex: 1; text-align: center; }
	.frame-bar a { color: #515767; text-decoration: none; }
	iframe { display: block; width: 100%; height: min(82vh, 860px); min-height: 520px; border: 0; background: white; }
	.review { margin: 1.1rem 0 0; padding: 1rem; border: 1px solid rgb(var(--gray-light)); border-radius: .85rem; background: #121720; }
	.review-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: .65rem; }
	.review-heading h2 { margin: 0; font-size: 1.1rem; }
	.review-heading > p { max-width: 32rem; margin: 0; color: rgb(var(--gray)); font-size: .68rem; text-align: right; }
	.feature-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .4rem; }
	.feature { padding: .7rem .75rem; border: 1px solid rgb(var(--gray-light) / 75%); border-radius: .65rem; background: rgb(var(--gray-light) / 7%); }
	.feature > div { display: flex; align-items: center; justify-content: space-between; gap: .4rem; }
	.feature h3 { margin: 0; font-size: .76rem; }
	.status { flex: 0 0 auto; padding: .16rem .42rem; border-radius: 99px; background: #343743; color: #d8dce8; font-size: .62rem; }
	.status.confirmed { background: #123d32; color: #85e5bd; }
	.status.check { background: #463718; color: #f2d28b; }
	.feature p { margin: .3rem 0 0; color: rgb(var(--gray)); font-size: .67rem; }
	.fit { margin: .75rem 0 0; color: rgb(var(--gray)); font-size: .73rem; }
	.fit strong { color: rgb(var(--gray-dark)); }
	.page-switch { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin: 1rem 0 .3rem; }
	.page-switch a { color: rgb(var(--gray-dark)); font-size: .73rem; text-decoration: none; }
	.page-switch a:hover { color: var(--accent); }
	@media(max-width:700px) {
		.theme-head { align-items: flex-start; flex-direction: column; }
		.head-actions { align-items: flex-start; }
		.preview-instructions { flex-direction: column; gap: .2rem; }
		iframe { height: 76vh; min-height: 440px; }
		.review-heading { align-items: flex-start; flex-direction: column; }
		.review-heading > p { text-align: left; }
		.feature-grid { grid-template-columns: 1fr; }
	}
</style>
