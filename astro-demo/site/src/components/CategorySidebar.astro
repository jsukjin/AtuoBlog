---
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../lib/taxonomy';

const posts = await getCollection('blog');
const activePath = Astro.url.pathname;
---

<aside class="category-sidebar" aria-label="블로그 카테고리">
	<p class="sidebar-title">카테고리</p>
	<nav aria-label="카테고리 목록">
		<a class="all-posts" href="/blog/">전체 글</a>
		{CATEGORIES.map((category) => {
			const count = posts.filter((post) => post.data.category.toLowerCase() === category.name.toLowerCase()).length;
			const href = `/category/${category.slug}/`;
			return (
				<a class:list={[{ active: activePath.startsWith(href) }]} href={href}>
					<span>{category.name}</span><span class="count">{count}</span>
				</a>
			);
		})}
	</nav>
	<p class="sidebar-note">글 분류는 Markdown의 <code>category</code> 항목에서 정합니다.</p>
</aside>

<style>
	.category-sidebar { position: sticky; top: 1.5rem; align-self: start; padding: 1.25rem; border: 1px solid rgb(var(--gray-light)); border-radius: 14px; background: color-mix(in srgb, var(--surface) 92%, transparent); }
	.sidebar-title { margin: 0 0 0.9rem; color: rgb(var(--black)); font-size: 0.9rem; font-weight: 700; }
	nav { display: grid; gap: 0.35rem; }
	nav a { display: flex; align-items: center; justify-content: space-between; padding: 0.55rem 0.7rem; border-radius: 9px; color: rgb(var(--gray-dark)); text-decoration: none; font-size: 0.88rem; }
	nav a:hover, nav a.active { background: #252d3b; color: rgb(var(--black)); }
	nav a.active { box-shadow: inset 3px 0 var(--accent); }
	nav a.all-posts { border-bottom: 1px solid rgb(var(--gray-light)); border-radius: 0; margin-bottom: 0.3rem; }
	.count { color: rgb(var(--gray)); font-size: 0.75rem; }
	.sidebar-note { margin: 1rem 0 0; color: rgb(var(--gray)); font-size: 0.72rem; line-height: 1.5; }
	.sidebar-note code { font-size: 0.72rem; }
	@media (max-width: 760px) {
		.category-sidebar { position: static; padding: 0.7rem 0.9rem; }
		.sidebar-title { margin-bottom: 0.45rem; }
		nav { display: flex; flex-wrap: wrap; gap: 0.25rem; }
		nav a { justify-content: center; padding: 0.45rem 0.3rem; }
		nav a.all-posts { border: 0; margin: 0; }
		.count, .sidebar-note { display: none; }
	}
</style>

