---
import type { CollectionEntry } from 'astro:content';
import { taxonomySlug } from '../lib/taxonomy';
import FormattedDate from './FormattedDate.astro';

interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const categorySlug = taxonomySlug(post.data.category);
---

<article class="post-card">
	<a class="post-title" href={`/blog/${post.id}/`}>
		<p class="post-meta"><span>{post.data.category}</span><span aria-hidden="true">·</span><FormattedDate date={post.data.pubDate} /></p>
		<h2>{post.data.title}</h2>
		<p class="description">{post.data.description}</p>
	</a>
	<div class="tags" aria-label="태그">
		{post.data.tags.map((tag) => <a href={`/tag/${taxonomySlug(tag)}/`}>#{tag}</a>)}
	</div>
</article>

<style>
	.post-card { min-width: 0; padding: 1.4rem 1.5rem; border: 1px solid rgb(var(--gray-light)); border-radius: 16px; background: color-mix(in srgb, var(--surface) 88%, transparent); transition: border-color 160ms ease, transform 160ms ease; }
	.post-card:hover { border-color: #65749a; transform: translateY(-2px); }
	.post-title { color: inherit; text-decoration: none; }
	.post-meta { display: flex; align-items: center; gap: 0.55rem; margin: 0 0 0.55rem; color: rgb(var(--gray)); font-size: 0.78rem; }
	.post-meta span:first-child { color: var(--accent); font-weight: 700; }
	h2 { margin: 0; font-size: 1.35rem; line-height: 1.35; }
	.description { margin: 0.5rem 0 0.9rem; color: rgb(var(--gray-dark)); font-size: 0.9rem; line-height: 1.6; }
	.tags { display: flex; flex-wrap: wrap; gap: 0.45rem; }
	.tags a { padding: 0.15rem 0.55rem; border: 1px solid rgb(var(--gray-light)); border-radius: 999px; color: rgb(var(--gray)); font-size: 0.72rem; text-decoration: none; }
	.tags a:hover { border-color: var(--accent); color: var(--accent); }
</style>

